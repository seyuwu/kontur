{
  "name": "kontur-care",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "push:configure-local": "node scripts/configure-push.mjs",
    "dev": "next dev --hostname 0.0.0.0",
    "dev:local": "next dev --hostname 127.0.0.1",
    "build": "npm run parser:build && prisma generate && next build",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed-assessments": "tsx scripts/seed-assessments.ts",
    "db:local": "node scripts/local-postgres.mjs",
    "worker": "tsx src/worker/index.ts",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:unit": "npm run parser:build && vitest run",
    "db:backup": "node scripts/backup.mjs",
    "db:restore-check": "node scripts/backup.mjs --verify",
    "measure:read": "tsx scripts/measure-read.ts",
    "deploy:prepare": "node scripts/prepare-deploy.mjs",
    "deploy:check": "node scripts/smoke-deploy.mjs",
    "db:backup-container": "node scripts/backup-container.mjs",
    "db:restore-container-check": "node scripts/backup-container.mjs --verify",
    "parser:build": "node scripts/build-parser.mjs",
    "llm:check": "tsx scripts/check-extraction.ts",
    "llm:check-summary": "tsx scripts/check-summary.ts",
    "llm:configure": "node scripts/configure-extraction.mjs",
    "llm:evaluate": "tsx scripts/evaluate-extraction.ts",
    "architecture:check": "node scripts/check-architecture.mjs",
    "assessment:publish": "tsx scripts/publish-assessment.ts",
    "metrics:read": "tsx scripts/measure-read.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.10",
    "@fontsource/manrope": "^5.2.8",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.10",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "graphile-worker": "0.18.0",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.13.0",
    "next": "16.4.2",
    "nodemailer": "10.2.1",
    "pg": "^8.16.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "unpdf": "^1.9.1",
    "web-push": "^3.6.7",
    "yauzl": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "@types/yauzl": "^3.4.0",
    "esbuild": "^0.28.2",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "prisma": "7.10.1",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
