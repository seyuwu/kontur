DATABASE_URL=postgresql://kontur:change-this-password@127.0.0.1:55432/kontur
POSTGRES_PASSWORD=change-this-password
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
DEMO_MODE=true
DEMO_PASSWORD=choose-a-local-demo-password


# Document extraction stays disabled until explicitly configured. Never commit real keys.
DOCUMENT_EXTRACTION_ENABLED=false
DOCUMENT_EXTRACTION_PROVIDER=groq
GROQ_API_KEY=
GROQ_EXTRACTION_MODEL=openai/gpt-oss-20b
LLM_SUMMARY_ENABLED=false
GROQ_SUMMARY_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=

# External email is opt-in; SMTP acceptance is not delivery/read confirmation.
ALERT_EMAIL_ENABLED=false
ALLOW_DEMO_ALERT_EMAIL=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Web Push is opt-in. Keep a persistent VAPID pair, shared by web and worker.
WEB_PUSH_ENABLED=false
ALLOW_DEMO_WEB_PUSH=false
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=

# Mistral: synthetic demo data only
MISTRAL_API_KEY=
MISTRAL_EXTRACTION_MODEL=ministral-14b-latest
MISTRAL_SUMMARY_MODEL=ministral-14b-latest
LLM_SUMMARY_PROVIDER=groq
